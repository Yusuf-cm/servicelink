# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=servicelink
DB_USER=servicelink_user
DB_PASSWORD=Markopolo
DB_HOST=localhost
DB_PORT=5432

# --- CORS (Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- M-Pesa Daraja API ---
# Get sandbox credentials at https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL (e.g. an ngrok tunnel in dev)
MPESA_CALLBACK_URL=https://example.com/api/payments/mpesa/callback/

# --- Credential verification ---
# 'mock' simulates NCA/EPRA lookups (default, no live registry API exists yet).
# 'live' is a placeholder for future real integration.
VERIFICATION_BACKEND=mock
